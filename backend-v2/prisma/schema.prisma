generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  ADMIN
  PRODUCTOR
  CLIENTE
}

enum TipoCliente {
  PERSONA
  EMPRESA
}

enum TipoRecurso {
  HUMANO
  MATERIAL
}

enum OrigenRecursoHumano {
  INTERNO
  EXTERNO
}

enum UnidadArriendo {
  HORA
  DIA
  EVENTO
}

enum EstadoDevolucionActivo {
  PENDIENTE
  CONFORME
  CON_OBSERVACIONES
}

enum EstadoVehiculo {
  DISPONIBLE
  EN_MANTENCION
  RETIRADO
}

enum EstadoEvento {
  CONFIRMADO
  POSPUESTO
  EN_CURSO
  COMPLETADO
  CANCELADO
}

enum TipoPago {
  ANTICIPO
  SALDO
}

enum ModalidadPrecioTipoEvento {
  FIJO
  POR_HORA
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  FALLIDO
  REEMBOLSADO
}

enum EstadoPresupuesto {
  BORRADOR
  PENDIENTE_PAGO
  ACEPTADO
  CANCELADO
  VENCIDO
}

enum TipoActividad {
  REUNION
  VISITA_RECINTO
  TAREA
}

enum EstadoActividad {
  PENDIENTE
  COMPLETADA
  CANCELADA
}

model Usuario {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  rol          RolUsuario
  activo       Boolean    @default(true)

  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?

  cliente   Cliente?
  productor Productor?

  solicitudesCreadas SolicitudEvento[] @relation("AutorSolicitud")
  cambiosSolicitud SolicitudEventoCambio[]
  cambiosEvento EventoCambio[]
  seguimientosEvento SeguimientoEvento[]
  comentariosSeguimiento ComentarioSeguimiento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cliente {
  id        Int         @id @default(autoincrement())
  usuarioId Int         @unique
  tipo      TipoCliente

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  persona      ClientePersona?
  empresa      ClienteEmpresa?
  eventos      Evento[]
  presupuestos Presupuesto[]
  solicitudes SolicitudEvento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientePersona {
  clienteId Int @id

  rut       String  @unique
  nombres   String
  apellidos String
  telefono  String?

  cliente Cliente @relation(fields: [clienteId], references: [id])
}

model ClienteEmpresa {
  clienteId Int @id

  rutEmpresa  String  @unique
  razonSocial String
  casaMatriz  String
  telefono    String?

  cliente Cliente @relation(fields: [clienteId], references: [id])
}

model Productor {
  id        Int @id @default(autoincrement())
  usuarioId Int @unique

  nombres   String
  apellidos String
  telefono  String?

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  eventos     Evento[]
  actividades ActividadProductor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TipoEvento {
  id                   Int     @id @default(autoincrement())
  nombre               String  @unique
  descripcion          String
  modalidadPrecio      ModalidadPrecioTipoEvento @default(FIJO)
  precioBase           Decimal? @db.Decimal(12, 2)
  tarifaHora           Decimal? @db.Decimal(12, 2)
  incluye              String?  @db.Text
  imagen_url           String? @db.Text
  cantidadPersonasBase Int
  activo               Boolean @default(true)

  eventos      Evento[]
  presupuestos Presupuesto[]
  solicitudes SolicitudEvento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Recurso {
  id          Int         @id @default(autoincrement())
  nombre      String
  descripcion String?
  tipo        TipoRecurso

  precioUnitario Decimal @db.Decimal(12, 2)
  stockTotal     Int
  cantidadEnMantencion Int @default(0)
  cantidadPerdida Int @default(0)
  activo         Boolean @default(true)

  material RecursoMaterial?
  humano   RecursoHumano?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventos      EventoRecurso[]
  presupuestos PresupuestoRecurso[]
  reservas ReservaRecurso[]

  @@unique([nombre, tipo])
}

model Espacio {
  id             Int             @id @default(autoincrement())
  nombre         String          @db.VarChar(100)
  direccion      String          @db.VarChar(250)
  capacidad      Int
  costoArriendo  Decimal?        @db.Decimal(12, 2)
  unidadArriendo UnidadArriendo?
  habilitado     Boolean         @default(true)
  observaciones  String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  reservas ReservaEspacio[]
  eventos  Evento[]

  @@index([nombre])
}

model ReservaEspacio {
  id         Int      @id @default(autoincrement())
  espacioId  Int
  referencia String   @db.VarChar(150)
  inicio     DateTime @db.Timestamptz(3)
  fin        DateTime @db.Timestamptz(3)
  cancelada  Boolean  @default(false)
  createdAt  DateTime @default(now())

  eventoId   Int?
  evento     Evento?  @relation(fields: [eventoId], references: [id], onDelete: Restrict)
  espacio Espacio @relation(fields: [espacioId], references: [id], onDelete: Restrict)

  @@index([eventoId])
  @@index([espacioId, inicio, fin])
}

model ReservaRecurso {
  id                      Int                    @id @default(autoincrement())
  recursoId               Int
  referencia              String                 @db.VarChar(150)
  cantidad                Int
  inicio                  DateTime               @db.Timestamptz(3)
  fin                     DateTime               @db.Timestamptz(3)
  cancelada               Boolean                @default(false)
  estadoDevolucion        EstadoDevolucionActivo @default(PENDIENTE)
  cantidadDanada          Int                    @default(0)
  cantidadPerdida         Int                    @default(0)
  observacionesDevolucion String?                @db.Text
  createdAt               DateTime               @default(now())

  eventoId                Int?
  evento                  Evento?                @relation(fields: [eventoId], references: [id], onDelete: Restrict)
  recurso Recurso @relation(fields: [recursoId], references: [id], onDelete: Restrict)

  @@index([eventoId])
  @@index([recursoId, inicio, fin])
}

model Vehiculo {
  id                 Int            @id @default(autoincrement())
  patente            String         @unique @db.VarChar(15)
  tipo               String         @db.VarChar(60)
  marca              String         @db.VarChar(60)
  modelo             String         @db.VarChar(80)
  anio               Int?
  capacidadPasajeros Int?
  estado             EstadoVehiculo @default(DISPONIBLE)
  observaciones      String?        @db.Text
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  reservas ReservaVehiculo[]

  @@index([estado, tipo])
}

model ReservaVehiculo {
  id                      Int                    @id @default(autoincrement())
  vehiculoId              Int
  referencia              String                 @db.VarChar(150)
  inicio                  DateTime               @db.Timestamptz(3)
  fin                     DateTime               @db.Timestamptz(3)
  cancelada               Boolean                @default(false)
  estadoDevolucion        EstadoDevolucionActivo @default(PENDIENTE)
  observacionesDevolucion String?                @db.Text
  createdAt               DateTime               @default(now())

  eventoId                Int?
  evento                  Evento?                @relation(fields: [eventoId], references: [id], onDelete: Restrict)
  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)

  @@index([eventoId])
  @@index([vehiculoId, inicio, fin])
}

model RecursoMaterial {
  recursoId Int @id

  unidad String?

  recurso Recurso @relation(fields: [recursoId], references: [id])
}

model RecursoHumano {
  recursoId Int @id

  origen OrigenRecursoHumano

  recurso Recurso @relation(fields: [recursoId], references: [id])
}

model Evento {
  id            Int          @id @default(autoincrement())
  clienteId     Int
  productorId   Int?
  tipoEventoId  Int
  inicio        DateTime
  fin           DateTime
  lugar         String
  asistentes    Int
  estado        EstadoEvento @default(CONFIRMADO)
  observaciones String?
  imagen_url    String? @db.Text

  calificacion Calificacion?

  cliente   Cliente   @relation(fields: [clienteId], references: [id])
  productor Productor? @relation(fields: [productorId], references: [id], onDelete: Restrict)
  tipoEvento TipoEvento @relation(fields: [tipoEventoId], references: [id])

  cambios     EventoCambio[]
  seguimientos SeguimientoEvento[]
  recursos    EventoRecurso[]
  actividades Actividad[]
  espacioId Int?
  espacio Espacio? @relation(fields: [espacioId], references: [id], onDelete: Restrict)
  reservasEspacio ReservaEspacio[]
  reservasRecurso ReservaRecurso[]
  reservasVehiculo ReservaVehiculo[]

  solicitudId Int? @unique
  solicitud SolicitudEvento? @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  presupuestoId Int         @unique
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([espacioId])
  @@index([clienteId])
  @@index([productorId])
  @@index([tipoEventoId])
  @@index([inicio, fin])
}

model EventoRecurso {
  eventoId  Int
  recursoId Int
  cantidad  Int

  evento  Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  recurso Recurso @relation(fields: [recursoId], references: [id])

  @@id([eventoId, recursoId])
  @@index([recursoId])
}

model Presupuesto {
  solicitudId Int?
  solicitud SolicitudEvento? @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  id           Int @id @default(autoincrement())
  clienteId    Int
  tipoEventoId Int

  inicio     DateTime
  fin        DateTime
  lugar      String
  asistentes Int
  venceAt    DateTime?

  // Snapshot del catálogo al momento de cotizar
  nombreTipoEvento     String
  precioBaseTipoEvento Decimal @db.Decimal(12, 2)

  subtotal       Decimal @db.Decimal(12, 2)
  recargoCliente Decimal @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  porcentajeAnticipo Decimal @db.Decimal(5, 2)
  montoAnticipo      Decimal @db.Decimal(12, 2)

  estado   EstadoPresupuesto    @default(BORRADOR)
  recursos PresupuestoRecurso[]
  pagos    Pago[]
  evento   Evento?

  cliente    Cliente    @relation(fields: [clienteId], references: [id])
  tipoEvento TipoEvento @relation(fields: [tipoEventoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([solicitudId])
  @@index([clienteId])
  @@index([tipoEventoId])
}

model PresupuestoRecurso {
  presupuestoId Int
  recursoId     Int

  nombreRecurso String
  tipoRecurso   TipoRecurso
  cantidad      Int

  precioUnitario Decimal @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  presupuesto Presupuesto @relation(fields: [presupuestoId], references: [id])
  recurso     Recurso     @relation(fields: [recursoId], references: [id])

  @@id([presupuestoId, recursoId])
  @@index([recursoId])
}

model Pago {
  id            Int @id @default(autoincrement())
  presupuestoId Int

  tipo   TipoPago
  monto  Decimal    @db.Decimal(12, 2)
  estado EstadoPago @default(PENDIENTE)

  fechaPago  DateTime?
  referencia String?

  presupuesto Presupuesto @relation(fields: [presupuestoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([presupuestoId])
}

model Calificacion {
  id       Int @id @default(autoincrement())
  eventoId Int @unique

  puntuacion Int
  comentario String?

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventoCambio {
  id        Int @id @default(autoincrement())
  eventoId  Int
  usuarioId Int

  campo         String
  valorAnterior String?
  valorNuevo    String?

  evento  Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())

  @@index([eventoId])
  @@index([usuarioId])
}

model Actividad {
  id          Int             @id @default(autoincrement())
  titulo      String          @db.VarChar(100)
  descripcion String?         @db.Text
  tipo        TipoActividad
  inicio      DateTime
  fin         DateTime
  lugar       String?         @db.VarChar(200)
  estado      EstadoActividad @default(PENDIENTE)

  productores ActividadProductor[]

  eventoId Int?
  evento   Evento? @relation(fields: [eventoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inicio, fin])
  @@index([eventoId])
}

model ActividadProductor {
  actividadId Int
  productorId Int
  esResponsable Boolean @default(false)

  actividad Actividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  productor Productor @relation(fields: [productorId], references: [id], onDelete: Cascade)

  @@id([actividadId, productorId])
  @@index([productorId])
  @@index([actividadId, esResponsable])
}

enum TipoSeguimiento {
  NOVEDAD
  INCIDENCIA
  OBSERVACION
  MODIFICACION
  HITO
}

enum ImportanciaSeguimiento {
  BAJA
  MEDIA
  ALTA
}

model SeguimientoEvento {
  id          Int @id @default(autoincrement())
  eventoId    Int
  usuarioId   Int
  descripcion String @db.Text
  tipo        TipoSeguimiento
  importancia ImportanciaSeguimiento
  createdAt   DateTime @default(now())

  evento      Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario     Usuario @relation(fields: [usuarioId], references: [id])
  comentarios ComentarioSeguimiento[]

  @@index([eventoId, createdAt, id])
  @@index([usuarioId])
}

model ComentarioSeguimiento {
  id            Int @id @default(autoincrement())
  seguimientoId Int
  usuarioId     Int
  comentario    String @db.Text
  createdAt     DateTime @default(now())

  seguimiento SeguimientoEvento @relation(fields: [seguimientoId], references: [id], onDelete: Cascade)
  usuario     Usuario @relation(fields: [usuarioId], references: [id])

  @@index([seguimientoId, createdAt, id])
  @@index([usuarioId])
}

enum EstadoSolicitudEvento {
  PENDIENTE
  EN_REVISION
  CONTRATADA
  RECHAZADA
}

model SolicitudEvento {
  id Int @id @default(autoincrement())
  clienteId Int
  tipoEventoId Int
  autorId Int
  inicio DateTime
  fin DateTime
  asistentes Int
  lugar String? @db.VarChar(200)
  observaciones String? @db.Text
  estado EstadoSolicitudEvento @default(PENDIENTE)
  tipoCierre String?
  motivoCierre String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  tipoEvento TipoEvento @relation(fields: [tipoEventoId], references: [id], onDelete: Restrict)
  autor Usuario @relation("AutorSolicitud", fields: [autorId], references: [id], onDelete: Restrict)
  presupuestos Presupuesto[]
  evento Evento?
  cambios SolicitudEventoCambio[]
  @@index([clienteId, createdAt])
  @@index([estado, createdAt])
  @@index([tipoEventoId])
}

model SolicitudEventoCambio {
  id Int @id @default(autoincrement())
  solicitudId Int
  actorId Int
  accion String
  motivo String? @db.Text
  anterior Json?
  nuevo Json?
  createdAt DateTime @default(now())
  solicitud SolicitudEvento @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  actor Usuario @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([solicitudId, createdAt])
  @@index([actorId])
}
